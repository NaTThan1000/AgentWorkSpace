{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://from-demo-to-spec.local/adapters/game-analysis-decision/f2s-producer-decision.schema.json",
  "title": "F2SProducerDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "request_id", "project_ref", "decision_packet_ref", "action",
    "producer_ref", "producer_confirmed", "host_record_ref", "host_record_confirmed", "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "type": "string", "pattern": "^HDR-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "request_id": { "type": "string", "pattern": "^ARQ-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "project_ref": { "type": "string", "pattern": "^f2s:[^\\s]+$" },
    "decision_packet_ref": { "type": "string", "pattern": "^decision:[^\\s]+$" },
    "action": { "type": "string", "enum": ["accepted", "rejected", "needs_evidence"] },
    "producer_ref": { "type": "string", "pattern": "^producer:[^\\s]+$" },
    "producer_confirmed": { "const": true },
    "host_record_ref": { "type": "string", "pattern": "^f2s:[^\\s]+$" },
    "host_record_confirmed": { "const": true },
    "recorded_at": { "type": "string", "format": "date-time" }
  }
}
