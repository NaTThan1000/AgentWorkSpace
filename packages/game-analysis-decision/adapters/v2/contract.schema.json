{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-analysis-decision.local/adapters/v2/contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {},
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "adapter_id",
        "host_ref",
        "host_write_target_ref",
        "created_at",
        "intent",
        "goal",
        "allowed_sources",
        "input_refs",
        "constraints",
        "budget"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "request_id": {
          "type": "string",
          "pattern": "^ARQ-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
        },
        "adapter_id": {
          "enum": [
            "standalone-adapter",
            "fromdemotospec-adapter",
            "brainstorm-adapter",
            "knowledge-adapter"
          ]
        },
        "host_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
        },
        "host_write_target_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "intent": {
          "enum": [
            "analyze",
            "decide",
            "verify"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "decision_question": {
          "type": "string",
          "minLength": 1
        },
        "allowed_sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "project",
              "knowledge",
              "web",
              "user_supplied"
            ]
          }
        },
        "input_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
          }
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "time_minutes",
            "tool_calls"
          ],
          "properties": {
            "time_minutes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            },
            "tool_calls": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          }
        }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "adapter_id",
        "host_ref",
        "host_write_target_ref",
        "delivery_id",
        "endpoint",
        "result_ref",
        "result_status",
        "action_class",
        "body",
        "source_refs",
        "limitations"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "request_id": {
          "type": "string",
          "pattern": "^ARQ-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
        },
        "adapter_id": {
          "enum": [
            "standalone-adapter",
            "fromdemotospec-adapter",
            "brainstorm-adapter",
            "knowledge-adapter"
          ]
        },
        "host_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
        },
        "host_write_target_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
        },
        "delivery_id": {
          "type": "string",
          "pattern": "^HOF-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
        },
        "endpoint": {
          "enum": [
            "analysis_report",
            "decision_packet",
            "experiment_plan"
          ]
        },
        "result_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
        },
        "result_status": {
          "enum": [
            "draft",
            "complete",
            "proposed",
            "rejected",
            "needs_evidence",
            "cancelled",
            "superseded"
          ]
        },
        "action_class": {
          "enum": [
            "analysis_only",
            "read_only_verification",
            "authorized_host_verification",
            "important_decision",
            "external_or_new_authority"
          ]
        },
        "authorization_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "format"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "format": {
              "const": "markdown"
            }
          }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "adapter_id",
        "host_ref",
        "host_write_target_ref",
        "delivery_id",
        "endpoint",
        "result_ref",
        "result_status",
        "action_class",
        "body",
        "source_refs",
        "limitations",
        "delivery_status",
        "next_action",
        "human_review",
        "permissions"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "request_id": {
          "type": "string",
          "pattern": "^ARQ-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
        },
        "adapter_id": {
          "enum": [
            "standalone-adapter",
            "fromdemotospec-adapter",
            "brainstorm-adapter",
            "knowledge-adapter"
          ]
        },
        "host_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
        },
        "host_write_target_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
        },
        "delivery_id": {
          "type": "string",
          "pattern": "^HOF-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
        },
        "endpoint": {
          "enum": [
            "analysis_report",
            "decision_packet",
            "experiment_plan"
          ]
        },
        "result_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
        },
        "result_status": {
          "enum": [
            "draft",
            "complete",
            "proposed",
            "rejected",
            "needs_evidence",
            "cancelled",
            "superseded"
          ]
        },
        "action_class": {
          "enum": [
            "analysis_only",
            "read_only_verification",
            "authorized_host_verification",
            "important_decision",
            "external_or_new_authority"
          ]
        },
        "authorization_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "format"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "format": {
              "const": "markdown"
            }
          }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
          }
        },
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "delivery_status": {
          "enum": [
            "ready_for_host",
            "needs_evidence",
            "terminal"
          ]
        },
        "next_action": {
          "enum": [
            "consume_analysis",
            "perform_read_only_verification",
            "perform_host_authorized_verification",
            "producer_decision",
            "request_authorization",
            "collect_evidence",
            "record_terminal_result"
          ]
        },
        "human_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "owner",
            "reason"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "owner": {
              "const": "host_user"
            },
            "reason": {
              "enum": [
                "important_decision",
                "new_authority",
                "none"
              ]
            }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host_write",
            "accept_decision",
            "run_experiment"
          ],
          "properties": {
            "host_write": {
              "const": false
            },
            "accept_decision": {
              "const": false
            },
            "run_experiment": {
              "const": false
            }
          }
        }
      }
    }
  }
}
