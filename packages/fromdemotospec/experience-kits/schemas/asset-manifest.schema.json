{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FromDemoToSpec project asset manifest",
  "type": "object",
  "required": [
    "schema_version",
    "prototype_id",
    "assets",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "selection_schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "lifecycle": {
      "enum": [
        "single-file",
        "maintained-project"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "project_path",
          "sha256",
          "license",
          "public_release_allowed",
          "source"
        ],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "type": "object",
            "required": [
              "provider",
              "url",
              "receipt_path"
            ],
            "properties": {
              "provenance_files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "project_path",
                    "sha256",
                    "source_path"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "selection_schema_version"
        ],
        "properties": {
          "selection_schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "lifecycle",
          "direction",
          "choice"
        ],
        "properties": {
          "assets": {
            "items": {
              "properties": {
                "source": {
                  "required": [
                    "provenance_files"
                  ],
                  "properties": {
                    "provenance_files": {
                      "minItems": 2
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
