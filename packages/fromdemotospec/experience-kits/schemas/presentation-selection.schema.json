{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FromDemoToSpec presentation selection v2 with explicit v1 compatibility",
  "oneOf": [
    {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "FromDemoToSpec presentation selection",
      "type": "object",
      "required": [
        "schema_version",
        "prototype_id",
        "presentation_grade",
        "selection_status",
        "kit",
        "view_contract",
        "asset_source",
        "assets"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "prototype_id": {
          "type": "string",
          "minLength": 1
        },
        "presentation_grade": {
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "selection_status": {
          "enum": [
            "auto",
            "confirmed",
            "fallback"
          ]
        },
        "kit": {
          "type": "object",
          "required": [
            "skeleton",
            "skin",
            "cast",
            "feedback_modules"
          ],
          "properties": {
            "skeleton": {
              "type": "string"
            },
            "skin": {
              "type": "string"
            },
            "cast": {
              "type": "string"
            },
            "feedback_modules": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "view_contract": {
          "type": "object",
          "required": [
            "state_source",
            "player_mode",
            "analysis_mode",
            "toggles"
          ],
          "properties": {
            "state_source": {
              "const": "shared"
            },
            "player_mode": {
              "const": "player"
            },
            "analysis_mode": {
              "const": "analysis"
            },
            "toggles": {
              "type": "array",
              "minItems": 4,
              "items": {
                "enum": [
                  "background",
                  "motion",
                  "vfx",
                  "audio"
                ]
              }
            }
          }
        },
        "asset_source": {
          "type": "object",
          "required": [
            "repository_id"
          ],
          "properties": {
            "repository_id": {
              "const": "prototype-assets"
            }
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "asset_id",
              "export_sha256"
            ]
          }
        },
        "presentation_brief": {
          "type": "object",
          "required": [
            "decision_owner",
            "input_type",
            "experience_moment",
            "first_screen_focus",
            "core_feedback_moment",
            "resource_exclusions"
          ],
          "properties": {
            "decision_owner": {
              "type": "string",
              "minLength": 1
            },
            "input_type": {
              "enum": [
                "sketch",
                "annotation",
                "reference_board",
                "quarantine_image",
                "text"
              ]
            },
            "experience_moment": {
              "type": "string",
              "minLength": 1
            },
            "first_screen_focus": {
              "type": "string",
              "minLength": 1
            },
            "core_feedback_moment": {
              "type": "string",
              "minLength": 1
            },
            "resource_exclusions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "preview_gate": {
          "type": "object",
          "required": [
            "status",
            "reviewer",
            "confirmed_at",
            "artifacts"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "confirmed"
              ]
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "confirmed_at": {
              "type": "string",
              "minLength": 1
            },
            "artifacts": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "path",
                  "decision"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "first_screen",
                      "core_feedback"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision": {
                    "const": "approved"
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "presentation_grade": {
                "enum": [
                  "B",
                  "C"
                ]
              }
            },
            "required": [
              "presentation_grade"
            ]
          },
          "then": {
            "required": [
              "presentation_brief",
              "preview_gate"
            ],
            "properties": {
              "selection_status": {
                "const": "confirmed"
              },
              "preview_gate": {
                "properties": {
                  "status": {
                    "const": "confirmed"
                  }
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "schema_version",
        "prototype_id",
        "lifecycle",
        "direction",
        "choice",
        "asset_source",
        "assets"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "prototype_id": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "enum": [
            "single-file",
            "maintained-project"
          ]
        },
        "direction": {
          "type": "object",
          "required": [
            "intent",
            "rationale"
          ],
          "properties": {
            "intent": {
              "type": "string",
              "minLength": 1
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "choice": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "agent",
                "user-constraint"
              ]
            },
            "source_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "user-constraint"
                  }
                }
              },
              "then": {
                "required": [
                  "source_ref"
                ]
              }
            }
          ]
        },
        "asset_source": {
          "type": "object",
          "required": [
            "repository_id"
          ],
          "properties": {
            "repository_id": {
              "const": "prototype-assets"
            }
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "asset_id",
              "export_sha256"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "export_sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        }
      }
    }
  ]
}
