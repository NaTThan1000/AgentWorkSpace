{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://from-demo-to-spec.local/adapters/game-analysis-decision/fromdemotospec-analysis-request.schema.json",
  "title": "F2SAnalysisRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "created_at", "command", "project_ref", "host_write_target_ref",
    "intent", "goal", "requester_role", "time_budget_minutes", "source_policy", "evidence_refs"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "pattern": "^ARQ-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "command": { "type": "string", "enum": ["request_analysis_decision", "lead_designer_takeover"] },
    "project_ref": { "type": "string", "pattern": "^f2s:[^\\s]+$" },
    "host_write_target_ref": { "type": "string", "pattern": "^f2s:[^\\s]+$" },
    "intent": { "type": "string", "enum": ["analyze", "decide"] },
    "goal": { "type": "string", "minLength": 8, "maxLength": 1000 },
    "decision_question": { "type": "string", "minLength": 8, "maxLength": 500 },
    "requester_role": { "type": "string", "enum": ["producer", "human", "agent", "system"] },
    "time_budget_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "source_policy": { "type": "string", "enum": ["project_only", "project_and_knowledge", "project_knowledge_and_web"] },
    "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$" } }
  }
}
