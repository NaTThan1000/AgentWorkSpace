{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ingest-semantic-review-v1",
  "title": "Ingest semantic review request and receipt",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/receipt" }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["severity", "category", "claim", "evidence_paths", "required_action"],
      "properties": {
        "severity": { "enum": ["blocking", "material", "advisory"] },
        "category": { "type": "string", "minLength": 1 },
        "claim": { "type": "string", "minLength": 1 },
        "evidence_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence_locations": { "type": "array", "items": { "type": "string" } },
        "required_action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["schema_version", "kind", "batch_id", "stage", "cycle", "producer_context_id", "evidence", "rubric_version"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "semantic_review_request" },
        "batch_id": { "type": "string", "minLength": 1 },
        "stage": { "enum": ["scoring", "stage1", "stage2", "stage3"] },
        "cycle": { "type": "integer", "minimum": 1 },
        "producer_context_id": { "type": "string", "minLength": 1 },
        "rubric_version": { "const": "INGEST_SEMANTIC_REVIEW_V1" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": ["schema_version", "kind", "batch_id", "stage", "cycle", "request_path", "request_sha256", "reviewer_context_id", "reviewer_model", "fresh_context", "verdict", "findings", "independent_conclusion", "comparison", "reviewed_at"],
      "properties": {
        "schema_version": { "const": 1 },
        "kind": { "const": "semantic_review_receipt" },
        "batch_id": { "type": "string", "minLength": 1 },
        "stage": { "enum": ["scoring", "stage1", "stage2", "stage3"] },
        "cycle": { "type": "integer", "minimum": 1 },
        "request_path": { "type": "string", "minLength": 1 },
        "request_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reviewer_context_id": { "type": "string", "minLength": 1 },
        "reviewer_model": { "type": "string", "minLength": 1 },
        "fresh_context": { "const": true },
        "verdict": { "enum": ["pass", "revise", "escalate"] },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "independent_conclusion": { "type": "string", "minLength": 1 },
        "comparison": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
