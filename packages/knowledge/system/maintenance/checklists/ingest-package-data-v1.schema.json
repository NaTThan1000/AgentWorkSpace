{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge.local/ingest-package-data-v1.schema.json",
  "title": "Knowledge ingest deterministic package data",
  "type": "object",
  "required": ["schema_version", "batch_id", "renderer_version", "sections"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "batch_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "renderer_version": { "const": "ingest-package-renderer-v1" },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoring", "stage1", "stage2", "stage3", "gate_audit"],
      "properties": {
        "scoring": { "$ref": "#/$defs/section" },
        "stage1": { "$ref": "#/$defs/section" },
        "stage2": { "$ref": "#/$defs/section" },
        "stage3": { "$ref": "#/$defs/section" },
        "gate_audit": { "$ref": "#/$defs/section" }
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "semantic", "derived", "section_sha256"],
      "properties": {
        "status": { "enum": ["open", "sealed"] },
        "semantic": { "$ref": "#/$defs/semantic" },
        "derived": { "type": "object" },
        "section_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "rows", "semantic_exceptions", "unresolved_risks", "structure_change_requests", "micro_failures"],
      "properties": {
        "summary": { "type": "string" },
        "rows": { "type": "array", "items": { "type": "object" } },
        "semantic_exceptions": { "type": "array", "items": { "type": "object" } },
        "unresolved_risks": { "type": "array", "items": { "type": "object" } },
        "structure_change_requests": { "type": "array", "items": { "type": "object" } },
        "micro_failures": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
