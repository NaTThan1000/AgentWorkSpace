{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/brainstorm/schemas/public-sources.schema.json",
  "title": "Public source bibliography",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "author_or_owner",
          "source_level",
          "url",
          "accessed_on",
          "license_status",
          "license",
          "reuse_scope"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9]+-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "author_or_owner": {
            "type": "string",
            "minLength": 1
          },
          "source_level": {
            "enum": [
              "original-bibliographic",
              "peer-reviewed-research",
              "authoritative-practice",
              "official-government",
              "secondary-practice"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "accessed_on": {
            "type": "string",
            "format": "date"
          },
          "license_status": {
            "enum": [
              "verified",
              "unverified",
              "link-only"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "reuse_scope": {
            "enum": [
              "metadata-and-facts",
              "attribution-noncommercial-adaptation",
              "link-only"
            ]
          }
        }
      }
    }
  }
}
