{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tylerbrainstorm.local/schemas/adapter-catalog-v1.json",
  "title": "Brainstorm adapter catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapters"],
  "properties": {
    "schema_version": { "const": 1 },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapter_id",
          "display_name",
          "status",
          "direction",
          "target_system",
          "input_kind",
          "output_path",
          "contract_path",
          "external_contract",
          "launches_external_flow",
          "degradation_supported"
        ],
        "properties": {
          "adapter_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["unavailable", "ready", "retired"] },
          "direction": { "const": "outbound" },
          "target_system": { "type": "string", "minLength": 1 },
          "input_kind": { "type": "string", "minLength": 1 },
          "output_path": { "type": "string", "pattern": "^[^/\\\\]+\\.(?:md|json)$" },
          "contract_path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+\\.md$" },
          "external_contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "version", "last_verified_against"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "last_verified_against": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
            }
          },
          "launches_external_flow": { "const": false },
          "degradation_supported": { "type": "boolean" }
        }
      }
    }
  }
}
