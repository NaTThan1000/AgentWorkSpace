{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tylerbrainstorm.local/schemas/playbook-catalog-v1.json",
  "title": "Brainstorm playbook catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "playbooks"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "playbooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/playbook"
      }
    }
  },
  "$defs": {
    "relative_markdown_path": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+\\.md$"
    },
    "playbook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "playbook_id",
        "display_name",
        "domain",
        "status",
        "path",
        "method_preset_path",
        "convergence_profile_path",
        "output_schema_path",
        "template_path",
        "method_ids",
        "single_user_ai_adaptation",
        "downstream_adapters"
      ],
      "properties": {
        "playbook_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["placeholder", "ready", "rejected"]
        },
        "path": {
          "$ref": "#/$defs/relative_markdown_path"
        },
        "method_preset_path": {
          "$ref": "#/$defs/relative_markdown_path"
        },
        "convergence_profile_path": {
          "$ref": "#/$defs/relative_markdown_path"
        },
        "output_schema_path": {
          "$ref": "#/$defs/relative_markdown_path"
        },
        "template_path": {
          "$ref": "#/$defs/relative_markdown_path"
        },
        "method_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "single_user_ai_adaptation": {
          "type": "boolean"
        },
        "downstream_adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adapter_id", "required", "status", "implementation_task"],
            "properties": {
              "adapter_id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "required": {
                "type": "boolean"
              },
              "status": {
                "enum": ["unavailable", "ready"]
              },
              "implementation_task": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ready"
              }
            }
          },
          "then": {
            "properties": {
              "single_user_ai_adaptation": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
