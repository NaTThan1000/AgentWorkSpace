{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tyler-brainstorm.local/schemas/session-state-v2.json",
  "title": "Brainstorm session state v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "title",
    "mode",
    "run_mode",
    "status",
    "visibility",
    "storage_kind",
    "host_project",
    "record_path",
    "pruning_authority",
    "delegated_scope",
    "goal_revision",
    "state_sequence",
    "pruning_sequence",
    "created_at",
    "updated_at",
    "closed_at",
    "state_history",
    "pruning_history"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "session_id": {
      "type": "string",
      "pattern": "^bs-[0-9]{8}-[0-9]{6}-[a-f0-9]{6}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "mode": {
      "enum": [
        "quick",
        "standard",
        "deep"
      ]
    },
    "status": {
      "enum": [
        "open",
        "paused",
        "converged",
        "handoff-ready",
        "closed"
      ]
    },
    "visibility": {
      "enum": [
        "private",
        "shareable",
        "example"
      ]
    },
    "storage_kind": {
      "enum": [
        "brainstorm",
        "host",
        "explicit"
      ]
    },
    "host_project": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_path": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.md$"
    },
    "pruning_authority": {
      "enum": [
        "confirm",
        "delegated"
      ]
    },
    "delegated_scope": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "current-session-current-goal"
      ]
    },
    "goal_revision": {
      "type": "integer",
      "minimum": 1
    },
    "state_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "pruning_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "state_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "from",
          "to",
          "event",
          "changed_at"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "from": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "open",
              "paused",
              "converged",
              "handoff-ready",
              "closed"
            ]
          },
          "to": {
            "enum": [
              "open",
              "paused",
              "converged",
              "handoff-ready",
              "closed"
            ]
          },
          "event": {
            "enum": [
              "created",
              "pause",
              "resume",
              "converge",
              "reopen",
              "handoff-ready",
              "close"
            ]
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "pruning_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "from",
          "to",
          "event",
          "changed_at"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "from": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "confirm",
              "delegated"
            ]
          },
          "to": {
            "enum": [
              "confirm",
              "delegated"
            ]
          },
          "event": {
            "enum": [
              "default",
              "delegated",
              "restored",
              "goal-changed",
              "session-closed"
            ]
          },
          "changed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "run_mode": {
      "enum": [
        "cocreate",
        "autonomous"
      ]
    }
  }
}
