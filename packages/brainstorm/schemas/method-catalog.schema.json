{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tyler.local/brainstorm/schemas/method-catalog.schema.json",
  "title": "Brainstorm method catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "methods"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method_id",
          "display_name",
          "category",
          "status",
          "path",
          "source_ids",
          "single_user_ai_adaptation",
          "version",
          "positive_case_id",
          "negative_case_id",
          "research_gap"
        ],
        "properties": {
          "method_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "capture",
              "framing",
              "divergence",
              "synthesis",
              "convergence"
            ]
          },
          "status": {
            "enum": [
              "ready",
              "placeholder",
              "rejected"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^methods/.+\\.md$"
          },
          "source_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^SRC-[A-Z0-9]+-[0-9]{3}$"
            }
          },
          "single_user_ai_adaptation": {
            "type": "boolean"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "positive_case_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "negative_case_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "research_gap": {
            "type": [
              "string",
              "null"
            ]
          },
          "ready_conditions": {
            "type": "array",
            "minItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "recommended_with": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "rejected_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "rejected_reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "placeholder"
                }
              }
            },
            "then": {
              "required": [
                "ready_conditions",
                "recommended_with"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "rejected"
                }
              }
            },
            "then": {
              "required": [
                "rejected_at",
                "rejected_reason"
              ]
            }
          }
        ]
      }
    }
  }
}
