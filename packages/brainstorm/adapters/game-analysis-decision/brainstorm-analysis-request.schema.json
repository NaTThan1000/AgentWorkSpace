{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "adapter_id",
    "host_ref",
    "host_write_target_ref",
    "created_at",
    "intent",
    "goal",
    "allowed_sources",
    "input_refs",
    "constraints",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "request_id": {
      "type": "string",
      "pattern": "^ARQ-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    },
    "adapter_id": {
      "const": "brainstorm-adapter"
    },
    "host_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
    },
    "host_write_target_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "intent": {
      "enum": [
        "analyze",
        "decide",
        "verify"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "decision_question": {
      "type": "string",
      "minLength": 1
    },
    "allowed_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "project",
          "knowledge",
          "web",
          "user_supplied"
        ]
      }
    },
    "input_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]*:[^\\s]+$"
      }
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_minutes",
        "tool_calls"
      ],
      "properties": {
        "time_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brainstorm GAD v2 request"
}
