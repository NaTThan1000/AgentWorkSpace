{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tylerbrainstorm.local/adapters/game-analysis-decision/brainstorm-producer-decision.schema.json",
  "title": "BrainstormProducerDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "request_id", "session_ref", "decision_packet_ref", "action",
    "decision_id", "decider", "producer_ref", "producer_confirmed", "host_record_ref",
    "host_record_confirmed", "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "type": "string", "pattern": "^HDR-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "request_id": { "type": "string", "pattern": "^ARQ-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "session_ref": { "type": "string", "pattern": "^brainstorm:[^\\s#]+$" },
    "decision_packet_ref": { "type": "string", "pattern": "^decision:[^\\s]+$" },
    "action": { "enum": ["accepted", "rejected", "needs_evidence"] },
    "decision_id": { "type": "string", "pattern": "^DEC-[0-9]{3,}$" },
    "decider": { "enum": ["user", "joint"] },
    "producer_ref": { "type": "string", "pattern": "^producer:[^\\s]+$" },
    "producer_confirmed": { "const": true },
    "host_record_ref": { "type": "string", "pattern": "^brainstorm:[^\\s]+$" },
    "host_record_confirmed": { "const": true },
    "recorded_at": { "type": "string", "format": "date-time" }
  }
}
