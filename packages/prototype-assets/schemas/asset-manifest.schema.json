{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype asset manifest",
  "type": "object",
  "required": [
    "schema_version",
    "asset_id",
    "category",
    "source",
    "license",
    "files",
    "public_release_allowed"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "asset_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:_-]*$" },
    "category": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["provider", "url", "fetched_at"],
      "properties": {
        "provider": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "fetched_at": { "type": "string", "format": "date-time" }
      }
    },
    "license": {
      "type": "object",
      "required": ["spdx", "receipt_path"],
      "properties": {
        "spdx": { "type": "string" },
        "receipt_path": { "type": "string" }
      }
    },
    "files": {
      "type": "object",
      "required": ["original_sha256", "normalized_sha256", "export_sha256"],
      "properties": {
        "original_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "normalized_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "export_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "public_release_allowed": { "type": "boolean" }
  },
  "additionalProperties": true
}
