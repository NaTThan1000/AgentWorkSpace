{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formal development asset v1 (additive to legacy FromDemoToSpec catalog)",
  "type": "object",
  "required": ["schema_version", "asset_id", "category", "consumers", "source", "license", "files", "normalized_path", "public_release_allowed", "processing", "decode"],
  "properties": {
    "schema_version": {"const": 1},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9:_-]*$"},
    "category": {"type": "string", "minLength": 1},
    "consumers": {"const": ["godot"]},
    "normalized_path": {"type": "string", "minLength": 1},
    "public_release_allowed": {"const": true},
    "source": {"type": "object", "required": ["provider", "url", "fetched_at", "source_id"]},
    "license": {"type": "object", "required": ["spdx", "receipt_path"]},
    "files": {"type": "object", "required": ["original_sha256", "normalized_sha256"]},
    "processing": {"type": "array", "minItems": 1},
    "decode": {"type": "object", "required": ["passed", "sha256"], "properties": {"passed": {"const": true}}}
  }
}
