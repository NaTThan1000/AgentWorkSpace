{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype asset license receipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "source_url", "license_spdx", "verified_at", "public_release_allowed"],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:_-]*$" },
    "source_url": { "type": "string", "format": "uri" },
    "license_spdx": { "type": "string" },
    "verified_at": { "type": "string", "format": "date-time" },
    "public_release_allowed": { "type": "boolean" }
  },
  "additionalProperties": true
}
