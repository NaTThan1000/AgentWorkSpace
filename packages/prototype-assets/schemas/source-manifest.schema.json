{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prototype asset source manifest",
  "type": "object",
  "required": ["schema_version", "source_id", "provider", "source_url", "license_spdx", "fetched_at", "archive_sha256"],
  "properties": {
    "schema_version": { "const": 1 },
    "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:_-]*$" },
    "provider": { "type": "string" },
    "source_url": { "type": "string", "format": "uri" },
    "license_spdx": { "type": "string" },
    "fetched_at": { "type": "string", "format": "date-time" },
    "archive_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
